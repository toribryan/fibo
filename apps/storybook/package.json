{
  "name": "storybook",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm manager:build && storybook dev -p 6006 --no-open",
    "build": "pnpm manager:build && storybook build",
    "manager:build": "vite build -c vite.manager.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings 0",
    "test": "vitest run",
    "chromatic": "chromatic --exit-zero-on-changes"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@workspace/ui": "workspace:*",
    "lucide-react": "^1.64.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.6.0",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/addon-vitest": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "@tailwindcss/postcss": "^4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "chromatic": "^18.13.6",
    "eslint": "^10.13.0",
    "eslint-plugin-storybook": "10.6.5",
    "playwright": "^1.64.1",
    "storybook": "10.6.0",
    "tailwindcss": "^4",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
