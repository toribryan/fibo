{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "env": ["FIBO_SITE_URL"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/ui/src/components/**",
        "$TURBO_ROOT$/packages/ui/components.meta.json",
        "$TURBO_ROOT$/packages/ui/src/styles/globals.css"
      ]
    },
    "smoke": {
      "cache": false,
      "env": ["KEEP_SMOKE_APP"]
    }
  }
}
