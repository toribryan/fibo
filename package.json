{
  "name": "golden-design-system",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "storybook": "turbo run dev --filter=storybook",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "check-types": "turbo typecheck",
    "format:check": "prettier --check . --cache",
    "format:write": "prettier --write . --cache",
    "registry:build": "pnpm --filter web registry:build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint-plugin-storybook": "10.6.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.10.12",
    "typescript": "^5",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20"
  }
}
