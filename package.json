{
  "name": "fibo",
  "version": "0.1.0",
  "private": true,
  "description": "An achromatic design system built on shadcn/ui and Base UI, documented in Storybook and installed from a shadcn registry.",
  "homepage": "https://fibo.toribryan.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toribryan/fibo.git"
  },
  "bugs": {
    "url": "https://github.com/toribryan/fibo/issues"
  },
  "license": "MIT",
  "author": "Tori Bryan (https://toribryan.com)",
  "keywords": [
    "design-system",
    "shadcn",
    "shadcn-registry",
    "base-ui",
    "tailwindcss",
    "storybook",
    "react"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "build:site": "pnpm build && rm -rf dist && cp -R apps/storybook/storybook-static dist && cp -R apps/registry/public/r dist/r && cp -R apps/registry/public/codemods dist/codemods && cp apps/registry/public/llms.txt dist/llms.txt",
    "storybook": "turbo run dev --filter=storybook",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format:check": "prettier --check . --cache",
    "format:write": "prettier --write . --cache",
    "registry:build": "pnpm --filter registry build",
    "21st:export": "pnpm --filter registry export:21st",
    "figma:drift": "node figma/drift.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.5",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=24"
  }
}
