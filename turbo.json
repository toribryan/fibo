{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [
        "public/r/**",
        "public/llms.txt",
        "public/codemods/**",
        "registry/**",
        "registry.json",
        "storybook-static/**"
      ]
    },
    "lint": {},
    "typecheck": {},
    "test": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
